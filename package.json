{
  "name": "@davidwuchta/liquid-glass",
  "version": "0.2.0",
  "description": "Apple-inspired Liquid Glass React component with GPU SVG refraction, chromatic dispersion, and specular rim lighting.",
  "license": "MIT",
  "author": "David Wuchta",
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "svg-filter",
    "refraction",
    "backdrop-filter",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidwuchta/liquid-glass.git"
  },
  "bugs": {
    "url": "https://github.com/davidwuchta/liquid-glass/issues"
  },
  "homepage": "https://github.com/davidwuchta/liquid-glass#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "playground": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5"
  }
}
